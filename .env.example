# Local development (MailHog - no OpenSSL needed)
MAIL_DRIVER=mailhog
MAIL_HOST=127.0.0.1
MAIL_PORT=1025

# Production (Gmail SMTP - requires PHP OpenSSL extension)
# MAIL_DRIVER=gmail
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-fullcourt-email@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM=your-fullcourt-email@gmail.com

# Production transactional email (Resend)
# RESEND_API_KEY=re_your-api-key
# RESEND_FROM=FullCourt <onboarding@resend.dev>
# HTTP_CA_BUNDLE=/path/to/cacert.pem
# Use a sender at your verified domain when deployed, e.g.
# RESEND_FROM=FullCourt <verify@updates.yourdomain.com>

# Production SMS verification (Semaphore Philippines)
# Create an account and API key at https://semaphore.co
# SEMAPHORE_API_KEY=your-semaphore-api-key
# SEMAPHORE_SENDER_NAME=FullCourt
# SEMAPHORE_OTP_URL=https://api.semaphore.co/api/v4/otp

# Database
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-reference
DB_PASS=your-database-password

# App
APP_ENV=development
APP_URL=http://127.0.0.1:5180
JWT_SECRET=generate-a-random-secret-with-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5180,http://localhost:5180
# APP_ENV=production
# APP_URL=https://your-fullcourt-domain.com
# CORS_ALLOWED_ORIGINS=https://your-fullcourt-domain.com
